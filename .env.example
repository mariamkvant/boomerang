# ===== REQUIRED =====

# Database (PostgreSQL connection string)
DATABASE_URL=postgresql://user:password@host:5432/boomerang

# Auth - MUST be a random 32+ character string in production
JWT_SECRET=change-me-to-a-random-secret-string

# Environment
NODE_ENV=production
PORT=3001

# CORS - comma-separated allowed origins
CORS_ORIGINS=https://www.boomerang.fyi,https://boomerang.fyi

# ===== EMAIL (Resend) =====
RESEND_API_KEY=re_xxxxxxxxxxxx
FROM_EMAIL=Boomerang <noreply@boomerang.fyi>

# ===== PAYMENTS (Stripe) =====
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# ===== IMAGE UPLOAD (Cloudinary) =====
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ===== PUSH NOTIFICATIONS (VAPID) =====
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@boomerang.fyi

# ===== BOG PAY (Bank of Georgia — for Georgian GEL payments) =====
# Register at https://ecommerce.bog.ge to get these credentials
# Also open a BOG Business account for B2B payout transfers
BOG_CLIENT_ID=your-bog-client-id
BOG_CLIENT_SECRET=your-bog-client-secret
BOG_MERCHANT_ID=your-bog-merchant-id
BOG_API_URL=https://api.bog.ge/payments/v1
BOG_CALLBACK_SECRET=your-bog-webhook-secret
# Your server's public URL (for BOG webhook callbacks)
SERVER_URL=https://boomerang.up.railway.app

# ===== ERROR MONITORING (Sentry) =====
# Create a project at https://sentry.io — free tier is enough
# Server DSN (add to Railway environment variables)
SENTRY_DSN=https://xxxx@oxxxx.ingest.sentry.io/xxxx
# Client DSN (add to Railway as VITE_SENTRY_DSN — must start with VITE_ to be exposed to browser)
VITE_SENTRY_DSN=https://xxxx@oxxxx.ingest.sentry.io/xxxx
